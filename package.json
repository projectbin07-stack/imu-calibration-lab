{
  "name": "imu-calibration-lab",
  "version": "0.2.0",
  "private": true,
  "description": "Calibrate accelerometers, gyroscopes and magnetometers from logged data and characterise IMU noise with Allan deviation.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"src/ui/app.js\" --test-coverage-exclude=\"src/ui/draw.js\" --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=80 \"tests/*.test.js\"",
    "typecheck": "tsc -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve": "node scripts/serve.js",
    "check": "npm run format:check && npm run typecheck && npm run coverage"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  },
  "bin": {
    "imu-calibration-lab": "bin/imu-calibration-lab.js"
  }
}
